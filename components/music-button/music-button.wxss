.music-button {
  position: fixed;
  right: 28rpx;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fffdf8;
}

.music-disc {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 253, 248, 0.4);
  border-radius: 50%;
  background: rgba(42, 37, 33, 0.58);
  box-shadow: 0 8rpx 24rpx rgba(32, 22, 14, 0.18);
}

.is-playing .music-disc {
  animation: music-spin 7s linear infinite;
}

.disc-hole {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.8);
}

.disc-note {
  margin-top: 1rpx;
  margin-left: 2rpx;
  font-size: 30rpx;
  line-height: 1;
}

.music-state {
  margin-top: 8rpx;
  font-size: 16rpx;
  letter-spacing: 0.12em;
  text-shadow: 0 2rpx 8rpx rgba(32, 22, 14, 0.4);
  opacity: 0.82;
}

.is-paused .music-disc {
  opacity: 0.68;
}

@keyframes music-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
