.countdown {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  color: inherit;
}

.countdown-item {
  min-width: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.countdown-num {
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  font-size: 48rpx;
  line-height: 1.1;
  letter-spacing: 0.02em;
  font-variant-numeric: tabular-nums;
}

.countdown-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  letter-spacing: 0.16em;
  opacity: 0.62;
}

.countdown-sep {
  margin: 4rpx 2rpx 0;
  font-size: 34rpx;
  line-height: 1.2;
  opacity: 0.4;
}

.countdown-ended {
  padding: 16rpx 30rpx;
  border: 1rpx solid currentColor;
  border-radius: 999rpx;
  font-size: 24rpx;
  letter-spacing: 0.12em;
  opacity: 0.72;
}
