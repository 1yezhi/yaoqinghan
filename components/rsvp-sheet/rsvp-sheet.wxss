.rsvp-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
}

.rsvp-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(32, 24, 17, 0.48);
}

.rsvp-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  padding: 18rpx 40rpx calc(env(safe-area-inset-bottom) + 24rpx);
  border-radius: 30rpx 30rpx 0 0;
  background: #fffdf8;
  box-shadow: 0 -18rpx 60rpx rgba(48, 32, 18, 0.2);
  box-sizing: border-box;
}

.sheet-handle {
  width: 70rpx;
  height: 6rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: rgba(42, 37, 33, 0.16);
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(42, 37, 33, 0.1);
}

.rsvp-kicker {
  color: #a9784b;
  font-size: 17rpx;
  letter-spacing: 0.24em;
}

.sheet-title {
  display: block;
  margin-top: 8rpx;
  font-size: 38rpx;
  line-height: 1.3;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  color: #7a6e63;
  font-size: 38rpx;
}

.sheet-body {
  flex: 1;
  height: 52vh;
  padding-top: 18rpx;
}

.preview-banner,
.existing-banner,
.deadline-banner {
  margin-bottom: 18rpx;
  padding: 14rpx 20rpx;
  border-radius: 10rpx;
  background: #f7efe2;
  color: #8a5a2b;
  font-size: 22rpx;
  line-height: 1.6;
}

.existing-banner {
  background: #eef2ea;
  color: #5f7059;
}

.deadline-banner {
  background: #f8e9e7;
  color: #a33a2b;
}

.form-field {
  margin: 22rpx 0;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #5f554b;
  font-size: 24rpx;
}

.required {
  color: #b3261e;
}

.field-optional {
  color: #a49a8e;
  font-size: 21rpx;
}

.field-input,
.field-textarea {
  width: 100%;
  min-height: 82rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(42, 37, 33, 0.14);
  border-radius: 12rpx;
  background: #fcf9f3;
  color: #2a2521;
  font-size: 27rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.field-textarea {
  min-height: 120rpx;
}

.field-input.is-error {
  border-color: rgba(179, 38, 30, 0.5);
}

.field-error {
  display: block;
  margin-top: 8rpx;
  color: #b3261e;
  font-size: 21rpx;
}

.field-count {
  display: block;
  margin-top: 6rpx;
  color: #a49a8e;
  font-size: 20rpx;
  text-align: right;
}

.attendance-row {
  display: flex;
}

.attendance-option:first-child {
  margin-right: 18rpx;
}

.attendance-option {
  flex: 1;
  padding: 20rpx 18rpx;
  border: 1rpx solid rgba(42, 37, 33, 0.14);
  border-radius: 14rpx;
  background: #fcf9f3;
}

.attendance-option.is-active {
  border-color: #a9784b;
  background: #f7efe2;
  box-shadow: 0 0 0 2rpx rgba(169, 120, 75, 0.12) inset;
}

.attendance-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.attendance-sub {
  display: block;
  margin-top: 4rpx;
  color: #8c8175;
  font-size: 20rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  border: 1rpx solid rgba(42, 37, 33, 0.16);
  border-radius: 50%;
  font-size: 30rpx;
}

.stepper-btn.is-disabled {
  opacity: 0.32;
}

.stepper-value {
  min-width: 46rpx;
  margin: 0 18rpx;
  text-align: center;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 30rpx;
}

.stepper-hint {
  margin-left: 4rpx;
  color: #a49a8e;
  font-size: 21rpx;
}

.consent-row {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
}

.checkbox {
  flex: none;
  margin-right: 14rpx;
  width: 34rpx;
  height: 34rpx;
  margin-top: 5rpx;
  line-height: 34rpx;
  text-align: center;
  border: 1rpx solid rgba(42, 37, 33, 0.3);
  border-radius: 6rpx;
  color: transparent;
  font-size: 22rpx;
}

.checkbox.is-checked {
  border-color: #a9784b;
  background: #a9784b;
  color: #fffdf8;
}

.consent-text {
  flex: 1;
  color: #6b6055;
  font-size: 21rpx;
  line-height: 1.7;
}

.privacy-purpose {
  display: block;
  margin-top: 10rpx;
  color: #a49a8e;
  font-size: 19rpx;
  line-height: 1.6;
}

.sheet-spacer {
  height: 24rpx;
}

.sheet-footer {
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(42, 37, 33, 0.1);
}

.rsvp-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  background: #a9784b;
  color: #fffdf8;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
}

.rsvp-primary.is-disabled {
  opacity: 0.42;
}

.rsvp-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 84rpx;
  border: 1rpx solid rgba(42, 37, 33, 0.18);
  border-radius: 999rpx;
  color: #4f463d;
  font-size: 26rpx;
}

.rsvp-success,
.sheet-deadline {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 8rpx 18rpx;
  text-align: center;
}

.success-mark {
  width: 84rpx;
  height: 84rpx;
  line-height: 80rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid rgba(169, 120, 75, 0.5);
  border-radius: 50%;
  color: #a9784b;
  font-size: 40rpx;
}

.rsvp-desc {
  margin-top: 16rpx;
  color: #7a6e63;
  font-size: 24rpx;
  line-height: 1.8;
}

.success-card,
.deadline-summary {
  width: 100%;
  margin-top: 28rpx;
  padding: 12rpx 24rpx;
  border: 1rpx solid rgba(42, 37, 33, 0.1);
  border-radius: 14rpx;
  background: #fcf9f3;
}

.success-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(42, 37, 33, 0.08);
}

.success-row:last-child {
  border-bottom: none;
}

.success-label {
  color: #8c8175;
  font-size: 23rpx;
}

.success-value {
  color: #2a2521;
  font-size: 24rpx;
  text-align: right;
}

.success-actions {
  width: 100%;
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
}

.success-actions .rsvp-primary {
  margin-top: 16rpx;
}

.deadline-summary {
  display: flex;
  flex-direction: column;
  color: #4f463d;
  font-size: 24rpx;
}

.deadline-summary text + text {
  margin-top: 8rpx;
}

.sheet-deadline .rsvp-primary {
  margin-top: 30rpx;
}

@media (max-width: 360px) {
  .rsvp-panel {
    padding-left: 28rpx;
    padding-right: 28rpx;
  }

  .sheet-body {
    height: 50vh;
  }
}
