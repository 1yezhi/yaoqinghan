<view
  class="envelope-stage theme-{{theme}} {{opening ? 'is-opening' : ''}} {{motion === 'reduced' ? 'motion-reduced' : ''}}"
  bindtap="onTap"
  aria-role="button"
  aria-label="轻触开启邀请函"
>
  <view class="stage-glow"></view>
  <view class="stage-ring ring-one"></view>
  <view class="stage-ring ring-two"></view>
  <view class="stage-grain"></view>

  <view class="stage-top">
    <text class="stage-kicker">YOU ARE INVITED</text>
    <view class="stage-rule"></view>
  </view>

  <view class="envelope">
    <view class="env-shadow"></view>
    <view class="env-card">
      <view class="card-border"></view>
      <text class="card-kicker">INVITATION</text>
      <text class="card-title serif">{{hosts || title}}</text>
      <view class="card-line"></view>
      <text class="card-date">{{dateText}}</text>
      <text class="card-note">期待与您相见</text>
    </view>
    <view class="env-back"></view>
    <view class="env-front">
      <view class="front-shade"></view>
      <view class="front-line"></view>
    </view>
    <view class="env-flap"></view>
    <view class="env-seal">
      <view class="seal-inner">{{seal}}</view>
    </view>
  </view>

  <view class="open-hint" wx:if="{{!opening}}">
    <view class="hint-line"></view>
    <text class="hint-main">轻触开启</text>
    <text class="hint-sub">请开启声音，沉浸浏览</text>
  </view>
  <view class="skip-hint" wx:else>轻触跳过动画</view>
</view>
