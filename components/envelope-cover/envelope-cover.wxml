<view
  class="envelope-stage theme-{{theme}} {{motion === 'reduced' ? 'motion-reduced' : ''}}"
  bindtap="onTap"
  aria-role="button"
  aria-label="轻触开启邀请函"
>
  <view class="stage-glow"></view>
  <view class="stage-ring ring-one"></view>
  <view class="stage-ring ring-two"></view>
  <view class="stage-grain"></view>

  <view class="stage-top">
    <text class="stage-kicker">YOU ARE INVITED</text>
    <view class="stage-rule"></view>
  </view>

  <view class="envelope-wrap">
    <!-- 信封分层：全部用包内 PNG + CSS transform，避免 Canvas 图片加载问题 -->
    <view
      class="envelope-art {{opening ? 'is-opening' : ''}} {{motion === 'reduced' ? 'is-static' : ''}}"
    >
      <view class="layer fb-shadow">
        <image src="/assets/envelope/shadow.png" mode="scaleToFill" />
      </view>
      <view class="layer fb-flap-back">
        <image src="/assets/envelope/flap-back.png" mode="scaleToFill" />
      </view>
      <view class="layer fb-letter">
        <image src="/assets/envelope/letter.png" mode="scaleToFill" />
      </view>
      <view class="layer fb-body">
        <image src="/assets/envelope/body.png" mode="scaleToFill" />
      </view>
      <view class="layer fb-pocket">
        <image src="/assets/envelope/pocket.png" mode="scaleToFill" />
      </view>
      <view class="layer fb-flap">
        <image src="/assets/envelope/flap-front.png" mode="scaleToFill" />
      </view>
      <view class="layer fb-sticker">
        <image src="/assets/envelope/sticker.png" mode="scaleToFill" />
      </view>
    </view>

    <!-- 动态姓名 / 日期 / 火漆字，不烘焙进图片 -->
    <view class="letter-copy {{opening ? 'is-opening' : ''}}">
      <text class="copy-name {{nameClass}}">{{hosts}}</text>
      <text class="copy-date">{{dateText}}</text>
      <view class="copy-seal">
        <text>{{seal}}</text>
      </view>
    </view>
  </view>

  <view class="open-hint" wx:if="{{!opening}}">
    <view class="hint-line"></view>
    <text class="hint-main">轻触开启</text>
    <text class="hint-sub">请开启声音，沉浸浏览</text>
  </view>
</view>
