<view
  class="envelope-stage theme-{{theme}} {{motion === 'reduced' ? 'motion-reduced' : ''}}"
  bindtap="onTap"
  aria-role="button"
  aria-label="轻触开启邀请函"
>
  <view class="stage-glow"></view>
  <view class="stage-ring ring-one"></view>
  <view class="stage-ring ring-two"></view>
  <view class="stage-grain"></view>

  <view class="stage-top">
    <text class="stage-kicker">YOU ARE INVITED</text>
    <view class="stage-rule"></view>
  </view>

  <view class="lottie-wrap">
    <canvas
      id="envelope-canvas"
      type="2d"
      class="lottie-canvas"
      bindtap="onTap"
      aria-role="button"
      aria-label="轻触开启邀请函"
    ></canvas>

    <!-- 静态分层兜底：Lottie 首帧确认前、或画布/图片不可用时显示 -->
    <view
      class="envelope-fallback {{opening ? 'is-opening' : ''}} {{motion === 'reduced' ? 'is-static' : ''}}"
      wx:if="{{showFallback}}"
    >
      <image class="fb-shadow" src="/assets/envelope/shadow.png" mode="scaleToFill" />
      <image class="fb-letter" src="/assets/envelope/letter.png" mode="scaleToFill" />
      <image class="fb-body" src="/assets/envelope/body.png" mode="scaleToFill" />
      <image class="fb-pocket" src="/assets/envelope/pocket.png" mode="scaleToFill" />
      <image class="fb-flap-back" src="/assets/envelope/flap-back.png" mode="scaleToFill" />
      <image class="fb-flap" src="/assets/envelope/flap-front.png" mode="scaleToFill" />
      <image class="fb-sticker" src="/assets/envelope/sticker.png" mode="scaleToFill" />
    </view>

    <canvas
      wx:if="{{textStage}}"
      id="text-canvas"
      type="2d"
      class="text-canvas"
      bindtap="onTap"
    ></canvas>
  </view>

  <view class="open-hint" wx:if="{{!opening}}">
    <view class="hint-line"></view>
    <text class="hint-main">轻触开启</text>
    <text class="hint-sub">请开启声音，沉浸浏览</text>
  </view>
</view>
