.envelope-stage {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 30%, rgba(255, 253, 248, 0.9), transparent 38%),
    linear-gradient(160deg, #f8f2e8 0%, #f1e6d6 55%, #eadcc8 100%);
  color: #2a2521;
}

.theme-gallery-noir {
  background:
    radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.8), transparent 36%),
    linear-gradient(160deg, #f4f3ef 0%, #e8e5df 100%);
}

.theme-chinese-ink {
  background:
    radial-gradient(circle at 50% 30%, rgba(255, 250, 240, 0.9), transparent 36%),
    linear-gradient(160deg, #f8f1e5 0%, #efe1cf 100%);
}

.stage-glow {
  position: absolute;
  top: 6%;
  left: 50%;
  width: 780rpx;
  height: 780rpx;
  margin-left: -390rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 252, 245, 0.88), rgba(255, 252, 245, 0));
  pointer-events: none;
}

.stage-ring {
  position: absolute;
  left: 50%;
  border: 1rpx solid rgba(169, 120, 75, 0.16);
  border-radius: 50%;
  pointer-events: none;
}

.ring-one {
  top: 12%;
  width: 760rpx;
  height: 760rpx;
  margin-left: -380rpx;
}

.ring-two {
  top: 20%;
  width: 580rpx;
  height: 580rpx;
  margin-left: -290rpx;
  border-color: rgba(169, 120, 75, 0.1);
}

.stage-grain {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  opacity: 0.16;
  background-image: radial-gradient(rgba(120, 90, 60, 0.22) 0.5rpx, transparent 0.5rpx);
  background-size: 7rpx 7rpx;
  pointer-events: none;
}

.stage-top {
  position: absolute;
  top: 10%;
  left: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
  z-index: 6;
}

.stage-kicker {
  color: #a9784b;
  font-size: 18rpx;
  letter-spacing: 0.32em;
  white-space: nowrap;
}

.stage-rule {
  width: 70rpx;
  height: 1rpx;
  margin-top: 14rpx;
  background: rgba(169, 120, 75, 0.5);
}

/* Lottie 画布：3:4 竖向舞台，居中偏上 */
.lottie-wrap {
  position: absolute;
  left: calc(50% - 21.75vh);
  top: 17%;
  width: 43.5vh;
  height: 58vh;
  z-index: 5;
}

.lottie-canvas,
.text-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.lottie-canvas {
  z-index: 1;
}

/* 动态姓名/日期画在独立透明画布上，避免被原生 canvas 盖住 */
.text-canvas {
  z-index: 2;
}

.open-hint {
  position: absolute;
  left: 50%;
  bottom: 8%;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
  z-index: 7;
}

.hint-line {
  width: 1rpx;
  height: 44rpx;
  margin-bottom: 18rpx;
  background: linear-gradient(180deg, rgba(169, 120, 75, 0), rgba(169, 120, 75, 0.65));
}

.hint-main {
  color: #7f4f25;
  font-size: 24rpx;
  letter-spacing: 0.22em;
}

.hint-sub {
  margin-top: 10rpx;
  color: #8b7c6d;
  font-size: 18rpx;
  letter-spacing: 0.08em;
}

.motion-reduced .stage-ring,
.motion-reduced .stage-grain {
  display: none;
}

@media (max-width: 360px) {
  .stage-top {
    top: 9%;
  }

  .hint-main {
    font-size: 22rpx;
  }

  .hint-sub {
    font-size: 17rpx;
  }
}
