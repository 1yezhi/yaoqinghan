.envelope-stage {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 30%, rgba(255, 253, 248, 0.9), transparent 38%),
    linear-gradient(160deg, #f8f2e8 0%, #f1e6d6 55%, #eadcc8 100%);
  color: #2a2521;
}

.theme-gallery-noir {
  background:
    radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.8), transparent 36%),
    linear-gradient(160deg, #f4f3ef 0%, #e8e5df 100%);
}

.theme-chinese-ink {
  background:
    radial-gradient(circle at 50% 30%, rgba(255, 250, 240, 0.9), transparent 36%),
    linear-gradient(160deg, #f8f1e5 0%, #efe1cf 100%);
}

.stage-glow {
  position: absolute;
  top: 6%;
  left: 50%;
  width: 780rpx;
  height: 780rpx;
  margin-left: -390rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 252, 245, 0.88), rgba(255, 252, 245, 0));
  pointer-events: none;
}

.stage-ring {
  position: absolute;
  left: 50%;
  border: 1rpx solid rgba(169, 120, 75, 0.16);
  border-radius: 50%;
  pointer-events: none;
}

.ring-one {
  top: 12%;
  width: 760rpx;
  height: 760rpx;
  margin-left: -380rpx;
}

.ring-two {
  top: 20%;
  width: 580rpx;
  height: 580rpx;
  margin-left: -290rpx;
  border-color: rgba(169, 120, 75, 0.1);
}

.stage-grain {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  opacity: 0.16;
  background-image: radial-gradient(rgba(120, 90, 60, 0.22) 0.5rpx, transparent 0.5rpx);
  background-size: 7rpx 7rpx;
  pointer-events: none;
}

.stage-top {
  position: absolute;
  top: 10%;
  left: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
  z-index: 6;
}

.stage-kicker {
  color: #a9784b;
  font-size: 18rpx;
  letter-spacing: 0.32em;
  white-space: nowrap;
}

.stage-rule {
  width: 70rpx;
  height: 1rpx;
  margin-top: 14rpx;
  background: rgba(169, 120, 75, 0.5);
}

/* 3:4 竖向舞台，居中偏上；内部百分比对应 Lottie 的 750×1000 坐标系 */
.envelope-wrap {
  position: absolute;
  left: calc(50% - 21.75vh);
  top: 17%;
  width: 43.5vh;
  height: 58vh;
  z-index: 5;
}

.envelope-art {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.envelope-art .layer {
  position: absolute;
  display: block;
}

.envelope-art .layer image {
  display: block;
  width: 100%;
  height: 100%;
}

/* 图层坐标：x/750、y/1000，宽高同理 */
.fb-shadow {
  left: 10%;
  top: 86%;
  width: 80%;
  height: 10%;
  z-index: 1;
}

.fb-flap-back {
  left: 7.333%;
  top: 13.533%;
  width: 85.333%;
  height: 38.467%;
  z-index: 2;
  opacity: 0;
  transform: scaleY(0.01);
  transform-origin: center bottom;
}

.fb-letter {
  left: 24.16%;
  top: 34.635%;
  width: 51.68%;
  height: 41.63%;
  z-index: 3;
  transform: translateY(34.5%) scale(0.843);
  transform-origin: center center;
}

.fb-body {
  left: 7.333%;
  top: 51.983%;
  width: 85.333%;
  height: 37.333%;
  z-index: 4;
}

.fb-pocket {
  left: 7.333%;
  top: 51.983%;
  width: 85.333%;
  height: 37.333%;
  z-index: 5;
}

.fb-flap {
  left: 7.333%;
  top: 52%;
  width: 85.333%;
  height: 29.267%;
  z-index: 6;
  transform-origin: center top;
}

.fb-sticker {
  left: 42.39%;
  top: 74.38%;
  width: 15.21%;
  height: 11.24%;
  z-index: 7;
  transform: scale(0.887);
  transform-origin: center center;
}

/* 动态文字：固定在舞台坐标，随信封淡出后由页面切换 */
.letter-copy {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 8;
  opacity: 0;
  pointer-events: none;
}

.letter-copy.is-opening {
  animation: copy-in-out 0.55s ease 0.95s forwards;
}

.copy-name {
  position: absolute;
  left: 50%;
  top: 49%;
  width: 44%;
  transform: translate(-50%, -50%);
  color: #7a1f1a;
  font-family: "Songti SC", "STSong", serif;
  font-size: 2.175vh;
  line-height: 1.3;
  letter-spacing: 0.02em;
  text-align: center;
}

.copy-name.is-long {
  font-size: 1.9vh;
}

.copy-name.is-xlong {
  font-size: 1.65vh;
}

.copy-date {
  position: absolute;
  left: 50%;
  top: 56%;
  transform: translate(-50%, -50%);
  color: rgba(246, 226, 196, 0.92);
  font-family: "Songti SC", "STSong", serif;
  font-size: 1.2vh;
  letter-spacing: 0.08em;
  text-shadow: 0 1rpx 2rpx rgba(80, 10, 10, 0.35);
}

.copy-seal {
  position: absolute;
  left: 50%;
  top: 65.5%;
  width: 3.74vh;
  height: 3.74vh;
  margin-left: -1.87vh;
  margin-top: -1.87vh;
  border: 1rpx solid rgba(246, 226, 196, 0.55);
  border-radius: 50%;
  color: rgba(246, 226, 196, 0.92);
  font-family: "Songti SC", "STSong", serif;
  font-size: 1.45vh;
  text-shadow: 0 1rpx 2rpx rgba(80, 10, 10, 0.35);
  line-height: 3.6vh;
  text-align: center;
}

.open-hint {
  position: absolute;
  left: 50%;
  bottom: 8%;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
  z-index: 7;
}

.hint-line {
  width: 1rpx;
  height: 44rpx;
  margin-bottom: 18rpx;
  background: linear-gradient(180deg, rgba(169, 120, 75, 0), rgba(169, 120, 75, 0.65));
}

.hint-main {
  color: #7f4f25;
  font-size: 24rpx;
  letter-spacing: 0.22em;
}

.hint-sub {
  margin-top: 10rpx;
  color: #8b7c6d;
  font-size: 18rpx;
  letter-spacing: 0.08em;
}

/* ---------- 开信时间线：0–1.5s ---------- */
.is-opening .fb-sticker {
  animation: fb-sticker-out 0.34s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

.is-opening .fb-flap {
  animation: fb-flap-fold 0.42s cubic-bezier(0.4, 0, 0.2, 1) 0.1s forwards;
}

.is-opening .fb-flap-back {
  animation: fb-flap-rise 0.36s cubic-bezier(0.4, 0, 0.2, 1) 0.27s forwards;
}

.is-opening .fb-letter {
  animation: fb-letter-out 0.53s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
}

.envelope-art.is-opening {
  animation: fb-fade-out 0.32s ease 1.18s forwards;
}

/* 减少动效：不播放位移和翻折 */
.is-static .fb-sticker,
.is-static .fb-flap,
.is-static .fb-flap-back,
.is-static .fb-letter,
.envelope-art.is-static,
.letter-copy.is-static {
  animation: none;
}

@keyframes fb-sticker-out {
  0% {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
  45% {
    transform: scale(1.16) rotate(6deg);
    opacity: 0.9;
  }
  100% {
    transform: scale(1.16) rotate(6deg);
    opacity: 0;
  }
}

@keyframes fb-flap-fold {
  0% {
    transform: scaleY(1);
    opacity: 1;
  }
  70% {
    opacity: 1;
  }
  100% {
    transform: scaleY(0.01);
    opacity: 0;
  }
}

@keyframes fb-flap-rise {
  0% {
    transform: scaleY(0.01);
    opacity: 0;
  }
  12% {
    opacity: 1;
  }
  100% {
    transform: scaleY(0.76);
    opacity: 1;
  }
}

@keyframes fb-letter-out {
  0% {
    transform: translateY(34.5%) scale(0.843);
  }
  100% {
    transform: translateY(0) scale(1);
  }
}

@keyframes fb-fade-out {
  0% {
    opacity: 1;
    transform: translateY(0);
  }
  100% {
    opacity: 0;
    transform: translateY(-1.5%);
  }
}

@keyframes copy-in-out {
  0% {
    opacity: 0;
    transform: translateY(6rpx);
  }
  45% {
    opacity: 1;
    transform: translateY(0);
  }
  75% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}

.motion-reduced .stage-ring,
.motion-reduced .stage-grain {
  display: none;
}

@media (max-width: 360px) {
  .stage-top {
    top: 9%;
  }

  .hint-main {
    font-size: 22rpx;
  }

  .hint-sub {
    font-size: 17rpx;
  }
}
