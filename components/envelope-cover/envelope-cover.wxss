.envelope-stage {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 30%, rgba(255, 253, 248, 0.9), transparent 38%),
    linear-gradient(160deg, #f8f2e8 0%, #f1e6d6 55%, #eadcc8 100%);
  color: #2a2521;
}

.theme-gallery-noir {
  background:
    radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.8), transparent 36%),
    linear-gradient(160deg, #f4f3ef 0%, #e8e5df 100%);
}

.theme-chinese-ink {
  background:
    radial-gradient(circle at 50% 30%, rgba(255, 250, 240, 0.9), transparent 36%),
    linear-gradient(160deg, #f8f1e5 0%, #efe1cf 100%);
}

.stage-glow {
  position: absolute;
  top: 6%;
  left: 50%;
  width: 780rpx;
  height: 780rpx;
  margin-left: -390rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 252, 245, 0.88), rgba(255, 252, 245, 0));
  pointer-events: none;
}

.stage-ring {
  position: absolute;
  left: 50%;
  border: 1rpx solid rgba(169, 120, 75, 0.16);
  border-radius: 50%;
  pointer-events: none;
}

.ring-one {
  top: 12%;
  width: 760rpx;
  height: 760rpx;
  margin-left: -380rpx;
}

.ring-two {
  top: 20%;
  width: 580rpx;
  height: 580rpx;
  margin-left: -290rpx;
  border-color: rgba(169, 120, 75, 0.1);
}

.stage-grain {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  opacity: 0.18;
  background-image: radial-gradient(rgba(120, 90, 60, 0.22) 0.5rpx, transparent 0.5rpx);
  background-size: 7rpx 7rpx;
  pointer-events: none;
}

.stage-top {
  position: absolute;
  top: 15%;
  left: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
  z-index: 6;
}

.stage-kicker {
  color: #a9784b;
  font-size: 18rpx;
  letter-spacing: 0.32em;
  white-space: nowrap;
}

.stage-rule {
  width: 70rpx;
  height: 1rpx;
  margin-top: 14rpx;
  background: rgba(169, 120, 75, 0.5);
}

.envelope {
  position: relative;
  width: 620rpx;
  height: 420rpx;
  margin-top: 70rpx;
  perspective: 1400rpx;
  transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  z-index: 5;
}

.is-opening .envelope {
  transform: translateY(-8rpx);
}

.env-shadow {
  position: absolute;
  left: 50%;
  bottom: -34rpx;
  width: 560rpx;
  height: 64rpx;
  margin-left: -280rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(72, 48, 28, 0.24) 0%, rgba(72, 48, 28, 0.1) 42%, rgba(72, 48, 28, 0) 72%);
  transition: opacity 600ms ease;
}

.is-opening .env-shadow {
  opacity: 0.4;
}

.env-back {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 10rpx;
  background: linear-gradient(165deg, #f4e7d6 0%, #e8d6bd 100%);
  border: 1rpx solid rgba(169, 120, 75, 0.34);
  box-shadow: 0 22rpx 50rpx rgba(87, 60, 35, 0.16);
  z-index: 1;
}

.env-card {
  position: absolute;
  left: 50rpx;
  top: 120rpx;
  width: 520rpx;
  height: 300rpx;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 4rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(169, 120, 75, 0.32);
  box-shadow: 0 10rpx 28rpx rgba(87, 60, 35, 0.12);
  transform: translateY(0) scale(0.97);
  opacity: 0.95;
  transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1) 280ms, opacity 700ms ease 280ms;
  z-index: 2;
}

.is-opening .env-card {
  transform: translateY(-260rpx) scale(1.03);
  opacity: 1;
}

.card-border {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  left: 12rpx;
  border: 1rpx solid rgba(169, 120, 75, 0.2);
  pointer-events: none;
}

.card-kicker {
  color: #a9784b;
  font-size: 16rpx;
  letter-spacing: 0.26em;
}

.card-title {
  margin-top: 14rpx;
  font-size: 40rpx;
  line-height: 1.3;
  text-align: center;
}

.card-line {
  width: 54rpx;
  height: 1rpx;
  margin: 14rpx 0;
  background: rgba(169, 120, 75, 0.55);
}

.card-date {
  color: #6e6257;
  font-size: 22rpx;
  letter-spacing: 0.16em;
}

.card-note {
  margin-top: 14rpx;
  color: #a9784b;
  font-size: 17rpx;
  letter-spacing: 0.16em;
}

.env-front {
  position: absolute;
  left: 0;
  top: 158rpx;
  width: 620rpx;
  height: 262rpx;
  overflow: hidden;
  border-radius: 0 0 10rpx 10rpx;
  background: linear-gradient(180deg, #ecdbc4 0%, #e3ceb3 100%);
  border: 1rpx solid rgba(169, 120, 75, 0.28);
  border-top: none;
  box-shadow: 0 -2rpx 0 rgba(255, 253, 248, 0.38) inset;
  z-index: 3;
}

.front-shade {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 150rpx;
  background: linear-gradient(180deg, rgba(255, 250, 240, 0.5), rgba(255, 250, 240, 0));
}

.front-line {
  position: absolute;
  left: 50%;
  top: 0;
  width: 1rpx;
  height: 150rpx;
  background: rgba(169, 120, 75, 0.16);
}

.env-flap {
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
  border-left: 310rpx solid transparent;
  border-right: 310rpx solid transparent;
  border-top: 220rpx solid #edddc7;
  transform-origin: top center;
  backface-visibility: hidden;
  transition: transform 700ms cubic-bezier(0.4, 0, 0.2, 1), opacity 400ms ease 450ms;
  z-index: 4;
}

.is-opening .env-flap {
  transform: rotateX(-158deg);
  opacity: 0;
}

.env-seal {
  position: absolute;
  left: 50%;
  top: 144rpx;
  width: 92rpx;
  height: 92rpx;
  margin-left: -46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 28%, #d3ad78, #a9784b 62%, #7f4f25 100%);
  box-shadow: 0 6rpx 14rpx rgba(87, 60, 35, 0.28);
  transition: transform 350ms ease, opacity 300ms ease;
  z-index: 5;
}

.is-opening .env-seal {
  transform: scale(1.18) rotate(12deg);
  opacity: 0;
}

.seal-inner {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 247, 231, 0.55);
  border-radius: 50%;
  color: #fff8ec;
  font-family: "Songti SC", "STSong", serif;
  font-size: 26rpx;
  letter-spacing: 0.02em;
}

.open-hint {
  position: absolute;
  left: 50%;
  bottom: 9%;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
  z-index: 7;
}

.hint-line {
  width: 1rpx;
  height: 44rpx;
  margin-bottom: 18rpx;
  background: linear-gradient(180deg, rgba(169, 120, 75, 0), rgba(169, 120, 75, 0.65));
}

.hint-main {
  color: #7f4f25;
  font-size: 24rpx;
  letter-spacing: 0.22em;
}

.hint-sub {
  margin-top: 10rpx;
  color: #8b7c6d;
  font-size: 18rpx;
  letter-spacing: 0.08em;
}

.skip-hint {
  position: absolute;
  left: 50%;
  bottom: 9%;
  transform: translateX(-50%);
  color: rgba(127, 79, 37, 0.65);
  font-size: 20rpx;
  letter-spacing: 0.12em;
  z-index: 7;
}

.is-opening .stage-top,
.is-opening .open-hint {
  opacity: 0;
  transition: opacity 220ms ease;
}

.is-opening .envelope {
  animation: envelope-breathe 1500ms ease forwards;
}

@keyframes envelope-breathe {
  0% {
    opacity: 1;
  }
  72% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translateY(-24rpx) scale(1.03);
  }
}


.motion-reduced .stage-ring,
.motion-reduced .stage-grain {
  display: none;
}

.motion-reduced .env-flap {
  transition-duration: 180ms;
}

.motion-reduced .env-card {
  transition-duration: 260ms;
  transition-delay: 80ms;
}

.motion-reduced .env-seal {
  transition-duration: 120ms;
}

.motion-reduced .envelope {
  animation-duration: 520ms;
}

@media (max-width: 360px) {
  .envelope {
    width: 560rpx;
    height: 380rpx;
  }

  .env-card {
    left: 44rpx;
    top: 108rpx;
    width: 472rpx;
    height: 272rpx;
  }

  .env-front {
    top: 144rpx;
    width: 560rpx;
    height: 236rpx;
  }

  .env-flap {
    border-left-width: 280rpx;
    border-right-width: 280rpx;
    border-top-width: 200rpx;
  }

  .env-seal {
    top: 132rpx;
  }
}
