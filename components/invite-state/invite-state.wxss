.state-wrap {
  min-height: 100vh;
  padding: 160rpx 56rpx 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: #f6f1e8;
  color: #2a2521;
}

.theme-gallery-noir {
  background: #f2f2f0;
  color: #1f1f1f;
}

.theme-chinese-ink {
  background: #f7f2e8;
  color: #231f1c;
}

.state-mark {
  display: flex;
  align-items: center;
  margin-bottom: 34rpx;
  color: #a9784b;
}

.mark-line {
  margin: 0 9rpx;
  width: 52rpx;
  height: 1rpx;
  background: currentColor;
  opacity: 0.55;
}

.mark-symbol {
  font-size: 24rpx;
}

.state-eyebrow {
  color: #a9784b;
  font-size: 20rpx;
  letter-spacing: 0.22em;
}

.state-title {
  margin-top: 18rpx;
  font-size: 42rpx;
  line-height: 1.4;
}

.state-desc {
  max-width: 520rpx;
  margin-top: 18rpx;
  color: #7a6e63;
  font-size: 26rpx;
  line-height: 1.8;
}

.state-btn {
  margin-top: 54rpx;
  padding: 0 42rpx;
  height: 80rpx;
  line-height: 80rpx;
  border: 1rpx solid rgba(42, 37, 33, 0.2);
  border-radius: 999rpx;
  color: #4f463d;
  font-size: 26rpx;
}
