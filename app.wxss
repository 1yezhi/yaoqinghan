page {
  min-height: 100%;
  background: #f6f1e8;
  color: #2a2521;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
button,
input,
textarea,
scroll-view,
swiper,
swiper-item {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
  text-align: inherit;
}

button::after {
  border: none;
}

image {
  display: block;
}

.serif {
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
}

.page-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f6f1e8;
}

.page-scroll {
  flex: 1;
  height: 0;
}

.muted {
  color: #7a6e63;
}

.hairline {
  height: 1rpx;
  background: rgba(42, 37, 33, 0.12);
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  background: #a9784b;
  color: #fffdf8;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.primary-btn[disabled] {
  opacity: 0.45;
}

.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 30rpx;
  border: 1rpx solid rgba(42, 37, 33, 0.18);
  border-radius: 999rpx;
  color: #4f463d;
  font-size: 26rpx;
}

.text-btn {
  display: inline-flex;
  align-items: center;
  color: #8a5a2b;
  font-size: 26rpx;
}

.empty-state {
  padding: 100rpx 40rpx;
  text-align: center;
  color: #7a6e63;
}
