.home-page {
  background: #f6f1e8;
}

.home-scroll {
  height: 0;
}

.home-hero {
  padding: 58rpx 44rpx 46rpx;
  background:
    radial-gradient(circle at 82% 8%, rgba(255, 253, 248, 0.9), transparent 36%),
    linear-gradient(155deg, #fbf7ef 0%, #f1e6d6 100%);
  border-bottom: 1rpx solid rgba(42, 37, 33, 0.08);
}

.home-kicker {
  display: block;
  color: #a9784b;
  font-size: 18rpx;
  letter-spacing: 0.28em;
}

.home-title {
  display: block;
  margin-top: 22rpx;
  color: #2a2521;
  font-size: 52rpx;
  line-height: 1.42;
  letter-spacing: 0.01em;
}

.home-title-line {
  display: block;
}

.home-sub {
  display: block;
  max-width: 580rpx;
  margin-top: 20rpx;
  color: #7a6e63;
  font-size: 24rpx;
  line-height: 1.8;
}

.home-actions {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
}

.create-btn {
  height: 82rpx;
  padding: 0 38rpx;
  font-size: 26rpx;
}

.demo-btn {
  height: 82rpx;
  margin-left: 18rpx;
  padding: 0 30rpx;
  background: rgba(255, 253, 248, 0.5);
  font-size: 24rpx;
}

.section-head-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 44rpx 44rpx 20rpx;
}

.list-title {
  color: #2a2521;
  font-size: 34rpx;
}

.list-count {
  color: #8c8175;
  font-size: 21rpx;
  letter-spacing: 0.08em;
}

.invite-list {
  padding: 0 44rpx;
}

.invite-card {
  margin-bottom: 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(42, 37, 33, 0.1);
  border-radius: 12rpx;
  background: #fffdf8;
  box-shadow: 0 18rpx 50rpx rgba(74, 52, 27, 0.07);
}

.card-cover {
  position: relative;
  height: 300rpx;
  overflow: hidden;
  background: #e8dccb;
}

.card-cover-img {
  width: 100%;
  height: 100%;
}

.card-cover-fallback {
  width: 100%;
  height: 100%;
  background:
    radial-gradient(circle at 70% 20%, rgba(255, 253, 248, 0.7), transparent 30%),
    linear-gradient(155deg, #d8c3a7, #9d8062);
}

.card-status {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.82);
  color: #7f4f25;
  font-size: 18rpx;
  letter-spacing: 0.08em;
}

.card-status.published {
  background: rgba(111, 127, 106, 0.92);
  color: #fffdf8;
}

.card-status.closed,
.card-status.expired {
  background: rgba(42, 37, 33, 0.65);
  color: #fffdf8;
}

.card-body {
  padding: 24rpx 28rpx 26rpx;
}

.card-title {
  display: block;
  color: #2a2521;
  font-size: 34rpx;
  line-height: 1.4;
}

.card-meta {
  display: block;
  margin-top: 8rpx;
  color: #7a6e63;
  font-size: 22rpx;
  line-height: 1.6;
}

.card-stats {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  color: #8c8175;
  font-size: 20rpx;
}

.stat-dot {
  margin: 0 10rpx;
  opacity: 0.55;
}

.card-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 10rpx;
}

.card-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  margin-top: 14rpx;
  margin-right: 12rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(42, 37, 33, 0.14);
  border-radius: 999rpx;
  color: #4f463d;
  font-size: 21rpx;
}

.card-btn.primary {
  border-color: #a9784b;
  background: #a9784b;
  color: #fffdf8;
}

.home-note {
  margin: 18rpx 44rpx 0;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(169, 120, 75, 0.14);
  border-radius: 10rpx;
  background: #f3e9db;
}

.note-title {
  display: block;
  color: #7f4f25;
  font-size: 22rpx;
  letter-spacing: 0.08em;
}

.note-text {
  display: block;
  margin-top: 8rpx;
  color: #7a6e63;
  font-size: 21rpx;
  line-height: 1.75;
}

.safe-bottom {
  height: 48rpx;
}
