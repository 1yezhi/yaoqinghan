{
  "pages": [
    "pages/index/index",
    "pages/invite/index"
  ],
  "subpackages": [
    {
      "root": "packageHost",
      "pages": [
        "pages/editor/index",
        "pages/responses/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": [
        "packageHost"
      ]
    }
  },
  "window": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "邀请函",
    "navigationStyle": "custom",
    "backgroundColor": "#F6F1E8",
    "backgroundTextStyle": "dark"
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "networkTimeout": {
    "request": 10000,
    "downloadFile": 10000
  }
}
