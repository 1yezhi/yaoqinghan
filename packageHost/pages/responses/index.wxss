.responses-page {
  height: 100vh;
  overflow: hidden;
  background: #f6f1e8;
}

.responses-scroll {
  flex: 1;
  height: 0;
}

.responses-hero {
  padding: 46rpx 44rpx 30rpx;
  background:
    radial-gradient(circle at 84% 8%, rgba(255, 253, 248, 0.9), transparent 34%),
    linear-gradient(155deg, #fbf7ef 0%, #f0e4d3 100%);
  border-bottom: 1rpx solid rgba(42, 37, 33, 0.08);
}

.responses-kicker {
  display: block;
  color: #a9784b;
  font-size: 18rpx;
  letter-spacing: 0.28em;
}

.responses-title {
  display: block;
  margin-top: 14rpx;
  color: #2a2521;
  font-size: 46rpx;
  line-height: 1.4;
}

.responses-sub {
  display: block;
  margin-top: 8rpx;
  color: #7a6e63;
  font-size: 21rpx;
}

.summary-grid {
  display: flex;
  padding: 24rpx 34rpx 8rpx;
}

.summary-card {
  flex: 1;
  padding: 22rpx 16rpx;
  margin: 0 6rpx;
  border: 1rpx solid rgba(42, 37, 33, 0.09);
  border-radius: 10rpx;
  background: #fffdf8;
  text-align: center;
}

.summary-num {
  display: block;
  color: #7f4f25;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 40rpx;
  line-height: 1.2;
}

.summary-label {
  display: block;
  margin-top: 6rpx;
  color: #8c8175;
  font-size: 19rpx;
}

.filter-bar {
  display: flex;
  padding: 18rpx 40rpx 8rpx;
}

.filter-tab {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  margin-right: 12rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(42, 37, 33, 0.12);
  border-radius: 999rpx;
  color: #7a6e63;
  font-size: 21rpx;
}

.filter-tab.is-active {
  border-color: #a9784b;
  background: #a9784b;
  color: #fffdf8;
}

.filter-count {
  margin-left: 8rpx;
  opacity: 0.66;
}

.response-list {
  padding: 14rpx 40rpx 0;
}

.response-card {
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(42, 37, 33, 0.09);
  border-radius: 12rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 32rpx rgba(74, 52, 27, 0.05);
}

.response-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.response-name {
  color: #2a2521;
  font-size: 32rpx;
}

.response-status {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #eef2ea;
  color: #5f7059;
  font-size: 19rpx;
}

.response-status.no {
  background: #f6ece2;
  color: #8c6a4a;
}

.response-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  color: #a49a8e;
  font-size: 19rpx;
}

.response-diet {
  display: block;
  margin-top: 14rpx;
  color: #7a6e63;
  font-size: 21rpx;
}

.response-message {
  display: block;
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  background: #fcf8f1;
  color: #6b6055;
  font-size: 21rpx;
  line-height: 1.7;
}

.responses-note {
  margin: 18rpx 40rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  background: #f3e9db;
  color: #7a6e63;
  font-size: 20rpx;
  line-height: 1.7;
}

.responses-actions {
  padding: 26rpx 40rpx 0;
}

.responses-actions .ghost-btn {
  width: 100%;
}

.safe-bottom {
  height: 48rpx;
}
